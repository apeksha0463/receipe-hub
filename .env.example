# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Use the anon / publishable key only. Never put the service_role / secret key here:
# every VITE_ variable is bundled into the public website.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
